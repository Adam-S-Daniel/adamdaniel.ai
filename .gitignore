# cms-platform consumer artifacts. The admin Decap config is generated from
# _config.yml's cms: block by the platform's admin tooling (do not commit the
# generated/local variants); the e2e lane checks the platform out here.
# Gemfile.lock stays TRACKED (committed) for deterministic builds.
admin/config.yml
admin/config-local.yml
.cms-platform/

