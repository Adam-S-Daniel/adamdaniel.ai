root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# 100-column house style for code. The formatters that enforce it (Prettier
# printWidth, Ruff line-length, RuboCop Layout/LineLength) live in the
# platform, not in this repo (no root npm toolchain since 2026-09-14); this
# file carries the editor hint. Markdown and YAML opt out below — prose,
# long URLs, and workflow expressions run longer.
max_line_length = 100

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
max_line_length = off

[{Gemfile,Gemfile.lock,Rakefile,*.rb}]
indent_size = 2

[*.{html,liquid}]
indent_size = 2

[Makefile]
indent_style = tab
