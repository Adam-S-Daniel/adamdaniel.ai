{
  // markdownlint-cli2 config for adamdaniel.ai prose docs.
  // Rule config lives in .markdownlint.jsonc (auto-discovered), but is
  // referenced here explicitly so a bare `markdownlint-cli2` invocation
  // (no globs) lints exactly the prose-doc scope and nothing else.
  //
  // CI command:  npx markdownlint-cli2
  "config": ".markdownlint.jsonc",

  // Lint ONLY the prose documentation owned by this scope.
  "globs": [
    "README.md",
    "AGENTS.md",
    "ANALYTICS_SETUP.md",
    "CLAUDE.md",
    "docs/**/*.md"
  ],

  // Never lint these:
  //  - CONTRIBUTOR_MANUAL.md is GENERATED by a build script.
  //  - Jekyll content markdown (_posts, _e2e, pages, preview.md) has YAML
  //    front matter and is content, not prose — owned elsewhere.
  //  - Skill mirrors (.agents, .claude) are guarded by a sync check.
  //  - Build/vendor/output dirs.
  "ignores": [
    "docs/CONTRIBUTOR_MANUAL.md",
    "node_modules",
    "_site",
    "_site*",
    "vendor",
    "_posts",
    "_e2e",
    "pages",
    "preview.md",
    ".agents",
    ".claude"
  ],

  // Do not follow .gitignore (so we control scope precisely via globs).
  "gitignore": false
}
